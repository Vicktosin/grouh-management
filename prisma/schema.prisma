generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())

  roles       Role[]
  staff       StaffMember[]
  leads       Lead[]
  tasks       Task[]
}

model Role {
  id               String   @id @default(cuid())
  companyId        String
  title            String
  level            Int
  parentRoleId     String?
  description      String?
  responsibilities String[]
  requirements     String[]
  qualifications   String[]
  roleType         String   @default("human") // "human", "human-ai"
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Role?        @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  children Role[]       @relation("RoleHierarchy")
  staff    StaffMember[]
  kpis     KPI[]
}

model StaffMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  roleId    String?
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  avatar    String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role             Role?             @relation(fields: [roleId], references: [id])
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  timeEntries      TimeEntry[]
  kpiReports       KPIReport[]
  leads            Lead[]
  leadInteractions LeadInteraction[]
  uploadedFiles    DriveFile[]        @relation("DriveFileUploader")
  createdFolders   DriveFolder[]      @relation("DriveFolderCreator")
  notifications    Notification[]
  followUpLogs     FollowUpLog[]      @relation("FollowUpLogs")
  devFocusItems    DevFocusItem[]
  productIdeas     ProductIdea[]
  companyPosts      CompanyPost[]
  postMentions      PostMention[]
  campaigns         Campaign[]
  marketingStrategy MarketingStrategy[]
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  description String?
  assigneeId  String
  creatorId   String
  dueDate     DateTime?
  status      String    @default("pending")
  priority    String    @default("medium")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee  StaffMember     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator   StaffMember     @relation("TaskCreator", fields: [creatorId], references: [id])
  fileLinks DriveFileTask[]
}

model KPI {
  id                String @id @default(cuid())
  roleId            String
  name              String
  description       String?
  measurementPeriod String
  targetValue       Float
  unit              String?

  role    Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  reports KPIReport[]
}

model KPIReport {
  id          String   @id @default(cuid())
  staffId     String
  kpiId       String
  periodStart DateTime
  periodEnd   DateTime
  value       Float
  notes       String?
  submittedAt DateTime @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])
  kpi   KPI         @relation(fields: [kpiId], references: [id])
}

model TimeEntry {
  id       String    @id @default(cuid())
  staffId  String
  clockIn  DateTime
  clockOut DateTime?
  notes    String?
  date     DateTime  @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])
}

model Lead {
  id         String   @id @default(cuid())
  companyId  String
  assigneeId String
  name       String?
  phone      String?
  email      String?
  source     String?
  status     String   @default("new")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee     StaffMember       @relation(fields: [assigneeId], references: [id])
  interactions LeadInteraction[]
  screenshots  LeadScreenshot[]
}

model LeadInteraction {
  id        String   @id @default(cuid())
  leadId    String
  staffId   String
  type      String
  notes     String?
  attempted Boolean  @default(true)
  outcome   String?
  createdAt DateTime @default(now())

  lead  Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff StaffMember @relation(fields: [staffId], references: [id])
}

model LeadScreenshot {
  id         String   @id @default(cuid())
  leadId     String
  imageUrl   String
  parsedData Json?
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ContentCalendar {
  id          String   @id @default(cuid())
  companyId   String
  name        String   @default("Main Calendar")
  description String?
  color       String   @default("#1c1d52")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots ContentSlot[]

  @@unique([companyId, name])
}

model ContentSlot {
  id         String   @id @default(cuid())
  calendarId String
  date       DateTime
  slotIndex  Int      @default(0)
  title      String?
  platform   String?
  contentType String? // "copy", "image", "video", "reel"
  driveUrl   String?
  status     String   @default("empty") // "empty", "draft", "ready"
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  calendar ContentCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date, slotIndex])
}

model DriveFolder {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  color       String   @default("#5fbb46")
  createdById String
  createdAt   DateTime @default(now())

  createdBy StaffMember @relation("DriveFolderCreator", fields: [createdById], references: [id])
  files     DriveFile[]
}

model DriveFile {
  id           String   @id @default(cuid())
  companyId    String
  folderId     String?
  title        String
  description  String?
  driveUrl     String
  fileType     String   @default("file") // doc, sheet, slide, video, image, pdf, folder, file
  driveFileId  String?  // extracted Google Drive file ID for thumbnail
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy StaffMember    @relation("DriveFileUploader", fields: [uploadedById], references: [id])
  folder     DriveFolder?   @relation(fields: [folderId], references: [id])
  taskLinks  DriveFileTask[]
}

model FollowUpLog {
  id            String   @id @default(cuid())
  staffId       String
  companyId     String
  logDate       DateTime // normalised to midnight UTC for the day
  isCleared     Boolean  @default(false)
  screenshotUrl String?
  notes         String?
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  staff StaffMember @relation("FollowUpLogs", fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, logDate])
}

model Notification {
  id        String   @id @default(cuid())
  staffId   String
  companyId String
  type      String   // task_assigned, task_overdue, task_due_soon, general
  title     String
  message   String
  urgency   String   @default("normal") // low, normal, high, critical
  isRead    Boolean  @default(false)
  relatedId String?  // taskId or other entity
  createdAt DateTime @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model DriveFileTask {
  fileId String
  taskId String

  file DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([fileId, taskId])
}

model Campaign {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  targetCompany String    @default("all")
  description   String?
  status        String    @default("planning") // planning, active, paused, completed
  budget        Float?
  startDate     DateTime?
  endDate       DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy   StaffMember          @relation(fields: [createdById], references: [id])
  channels    CampaignChannel[]
  performance ChannelPerformance[]
}

model MarketingChannel {
  id        String   @id @default(cuid())
  companyId String
  name      String
  type      String   @default("digital") // digital, traditional, influencer, other
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  campaigns   CampaignChannel[]
  performance ChannelPerformance[]
}

model CampaignChannel {
  campaignId String
  channelId  String

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel  MarketingChannel @relation(fields: [channelId], references: [id])

  @@id([campaignId, channelId])
}

model ChannelPerformance {
  id          String   @id @default(cuid())
  companyId   String
  campaignId  String
  channelId   String
  periodLabel String
  spend       Float    @default(0)
  reach       Float    @default(0)
  impressions Float    @default(0)
  clicks      Float    @default(0)
  conversions Float    @default(0)
  notes       String?
  loggedAt    DateTime @default(now())

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel  MarketingChannel @relation(fields: [channelId], references: [id])
}

model MarketingStrategy {
  id            String   @id @default(cuid())
  companyId     String
  title         String
  type          String   @default("research") // research, competitor, positioning, brief
  targetCompany String   @default("all")
  body          String
  status        String   @default("draft") // draft, final
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy StaffMember @relation(fields: [createdById], references: [id])
}

model CompanyPost {
  id        String    @id @default(cuid())
  companyId String
  authorId  String
  content   String    // may contain @[Full Name](staffId) mention markers
  type      String    @default("general") // general, announcement, event
  isPinned  Boolean   @default(false)
  eventDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author   StaffMember   @relation(fields: [authorId], references: [id])
  mentions PostMention[]
}

model PostMention {
  postId  String
  staffId String

  post  CompanyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  staff StaffMember @relation(fields: [staffId], references: [id])

  @@id([postId, staffId])
}

model DevFocusItem {
  id        String   @id @default(cuid())
  companyId String
  staffId   String
  text      String
  isDone    Boolean  @default(false)
  date      DateTime // normalised to day (midnight UTC)
  createdAt DateTime @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model SoftwareTool {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  category    String   @default("other") // hosting, database, design, communication, dev, marketing, other
  usedBy      String   @default("all")   // all, academy, software, marketing, entertainment
  url         String?
  monthlyCost Float    @default(0)
  status      String   @default("active") // active, warning, down, deprecated
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductIdea {
  id            String   @id @default(cuid())
  companyId     String
  title         String
  description   String?
  status        String   @default("concept") // concept, planning, in-dev, live, archived
  targetCompany String   @default("all")
  priority      String   @default("medium") // low, medium, high
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy StaffMember @relation(fields: [createdById], references: [id])
}
