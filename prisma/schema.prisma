generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  createdAt DateTime @default(now())

  roles       Role[]
  staff       StaffMember[]
  leads       Lead[]
  tasks       Task[]
}

model Role {
  id               String   @id @default(cuid())
  companyId        String
  title            String
  level            Int
  parentRoleId     String?
  description      String?
  responsibilities String[]
  requirements     String[]
  qualifications   String[]
  roleType         String   @default("human") // "human", "human-ai"
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Role?        @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  children Role[]       @relation("RoleHierarchy")
  staff    StaffMember[]
  kpis     KPI[]
}

model StaffMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  roleId    String?
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  avatar    String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role             Role?             @relation(fields: [roleId], references: [id])
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  timeEntries      TimeEntry[]
  kpiReports       KPIReport[]
  leads            Lead[]
  leadInteractions LeadInteraction[]
  uploadedFiles    DriveFile[]       @relation("DriveFileUploader")
  createdFolders   DriveFolder[]     @relation("DriveFolderCreator")
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  description String?
  assigneeId  String
  creatorId   String
  dueDate     DateTime?
  status      String    @default("pending")
  priority    String    @default("medium")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee  StaffMember     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator   StaffMember     @relation("TaskCreator", fields: [creatorId], references: [id])
  fileLinks DriveFileTask[]
}

model KPI {
  id                String @id @default(cuid())
  roleId            String
  name              String
  description       String?
  measurementPeriod String
  targetValue       Float
  unit              String?

  role    Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  reports KPIReport[]
}

model KPIReport {
  id          String   @id @default(cuid())
  staffId     String
  kpiId       String
  periodStart DateTime
  periodEnd   DateTime
  value       Float
  notes       String?
  submittedAt DateTime @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])
  kpi   KPI         @relation(fields: [kpiId], references: [id])
}

model TimeEntry {
  id       String    @id @default(cuid())
  staffId  String
  clockIn  DateTime
  clockOut DateTime?
  notes    String?
  date     DateTime  @default(now())

  staff StaffMember @relation(fields: [staffId], references: [id])
}

model Lead {
  id         String   @id @default(cuid())
  companyId  String
  assigneeId String
  name       String?
  phone      String?
  email      String?
  source     String?
  status     String   @default("new")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee     StaffMember       @relation(fields: [assigneeId], references: [id])
  interactions LeadInteraction[]
  screenshots  LeadScreenshot[]
}

model LeadInteraction {
  id        String   @id @default(cuid())
  leadId    String
  staffId   String
  type      String
  notes     String?
  attempted Boolean  @default(true)
  outcome   String?
  createdAt DateTime @default(now())

  lead  Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staff StaffMember @relation(fields: [staffId], references: [id])
}

model LeadScreenshot {
  id         String   @id @default(cuid())
  leadId     String
  imageUrl   String
  parsedData Json?
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model ContentCalendar {
  id          String   @id @default(cuid())
  companyId   String
  name        String   @default("Main Calendar")
  description String?
  color       String   @default("#1c1d52")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots ContentSlot[]

  @@unique([companyId, name])
}

model ContentSlot {
  id         String   @id @default(cuid())
  calendarId String
  date       DateTime
  slotIndex  Int      @default(0)
  title      String?
  platform   String?
  contentType String? // "copy", "image", "video", "reel"
  driveUrl   String?
  status     String   @default("empty") // "empty", "draft", "ready"
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  calendar ContentCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date, slotIndex])
}

model DriveFolder {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  color       String   @default("#5fbb46")
  createdById String
  createdAt   DateTime @default(now())

  createdBy StaffMember @relation("DriveFolderCreator", fields: [createdById], references: [id])
  files     DriveFile[]
}

model DriveFile {
  id           String   @id @default(cuid())
  companyId    String
  folderId     String?
  title        String
  description  String?
  driveUrl     String
  fileType     String   @default("file") // doc, sheet, slide, video, image, pdf, folder, file
  driveFileId  String?  // extracted Google Drive file ID for thumbnail
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy StaffMember    @relation("DriveFileUploader", fields: [uploadedById], references: [id])
  folder     DriveFolder?   @relation(fields: [folderId], references: [id])
  taskLinks  DriveFileTask[]
}

model DriveFileTask {
  fileId String
  taskId String

  file DriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([fileId, taskId])
}
